{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "example": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/example",
      "sourceRoot": "projects/example/src",
      "prefix": "lh",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/example",
            "index": "projects/example/src/index.html",
            "browser": "projects/example/src/main.ts",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "tsConfig": "projects/example/tsconfig.app.json",
            "assets": [
              "projects/example/src/favicon.ico",
              {
                "glob": "**/*",
                "input": "projects/example/src/assets",
                "output": "assets"
              }
            ],
            "styles": ["projects/example/src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/example/src/environments/environment.ts",
                  "with": "projects/example/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "example:build",
            "proxyConfig": "projects/example/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "example:build:production"
            },
            "development": {
              "buildTarget": "example:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "example:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/example/src/**/*.ts",
              "projects/example/src/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/example/src/test.ts",
            "tsConfig": "projects/example/tsconfig.spec.json",
            "karmaConfig": "projects/example/karma.conf.js",
            "polyfills": ["zone.js", "zone.js/testing", "@angular/localize/init"],
            "assets": [
              "projects/example/src/favicon.ico",
              {
                "glob": "**/*",
                "input": "projects/example/src/assets",
                "output": "assets"
              }
            ],
            "styles": ["projects/example/src/styles.css"],
            "scripts": []
          }
        }
      }
    },
    "odata-observable-store": {
      "projectType": "library",
      "root": "projects/odata-observable-store",
      "sourceRoot": "projects/odata-observable-store/src",
      "prefix": "lh",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/odata-observable-store/tsconfig.lib.json",
            "project": "projects/odata-observable-store/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/odata-observable-store/tsconfig.lib.prod.json"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/odata-observable-store/src/**/*.ts",
              "projects/odata-observable-store/src/**/*.html"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/odata-observable-store/src/test.ts",
            "tsConfig": "projects/odata-observable-store/tsconfig.spec.json",
            "karmaConfig": "projects/odata-observable-store/karma.conf.js",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  }
}
